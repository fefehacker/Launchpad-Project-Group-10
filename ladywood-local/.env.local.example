# Copy this file to .env.local and fill in all values.
# Never commit .env.local — it is in .gitignore.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ── Google Maps ───────────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Google Cloud Console → Google Maps Platform → Map Management → Create Map ID
# Required for AdvancedMarker — without this markers silently fail in production
NEXT_PUBLIC_MAP_ID=your-map-id

# ── Resend (email broadcasts from /admin) ─────────────────────────────────────
# resend.com → API Keys
# No NEXT_PUBLIC_ prefix — this key must stay server-side only
RESEND_API_KEY=re_your_api_key

# The "from" address for broadcast emails. Requires a verified domain in Resend.
# For local testing only you can use: Ladywood Local <onboarding@resend.dev>
# (onboarding@resend.dev only delivers to your own Resend account email)
RESEND_FROM_EMAIL=Ladywood Local <updates@yourdomain.com>
