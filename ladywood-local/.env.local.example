# Example .env.local for local development — DO NOT COMMIT
# Copy this file to `.env.local` and replace the placeholder values with your real keys.

# Google Maps JavaScript API key (restrict by HTTP referrer and Maps JS API only)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Supabase: project URL and anon/public key (both must be prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# After creating `.env.local`, restart the dev server: `npm run dev` in ladywood-local
# Keep `.env.local` out of source control. The repo .gitignore should already exclude it.
